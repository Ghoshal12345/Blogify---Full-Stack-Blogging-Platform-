<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head') %>
    <title><%= blog.title %> - Blogify</title>
</head>

<body>
    <%- include('./partials/nav') %>

    <!-- Blog Post Container -->
    <div class="container mt-4 mb-5">
        <!-- Blog Header Card -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <!-- Blog Title -->
                <h1 class="display-4 fw-bold mb-3">
                    <%= blog.title %>
                </h1>

                <!-- Author and Date Info -->
                <% if (blog.createdBy) { %>
                    <div class="d-flex align-items-center mb-3">
                        <div class="avatar-circle bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" 
                            style="width: 50px; height: 50px; font-weight: bold; font-size: 1.2rem;">
                            <%= blog.createdBy.fullName.charAt(0).toUpperCase() %>
                        </div>
                        <div>
                            <p class="mb-0 fw-bold text-dark">
                                <%= blog.createdBy.fullName %>
                            </p>
                            <p class="mb-0 text-muted small">
                                <i class="bi bi-calendar3"></i> <%= new Date(blog.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                            </p>
                        </div>
                    </div>
                <% } %>

                <!-- Cover Image -->
                <% if (locals.blog.coverImageURL) { %>
                    <div class="mb-4 text-center">
                        <img src="<%= blog.coverImageURL %>" class="img-fluid rounded shadow" alt="<%= blog.title %>"
                            style="max-height: 500px; width: 100%; object-fit: cover;">
                    </div>
                <% } %>

                <!-- Blog Content -->
                <div class="blog-content mt-4">
                    <div class="lead" style="white-space: pre-wrap; line-height: 1.8; font-size: 1.1rem;">
                        <%= blog.body %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Comments Section -->
        <div class="container m-5">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-chat-dots"></i> Comments (<%= blog.comments ? blog.comments.length : 0 %>)</h4>
                </div>
                <div class="card-body">
                    <% if (locals.user) { %>
                        <form action="/blog/comment/<%= blog._id %>" method="POST" class="mb-4">
                            <div class="mb-3">
                                <label for="commentInput" class="form-label fw-bold">Add your comment</label>
                                <textarea name="content" id="commentInput" class="form-control" rows="3" 
                                    placeholder="Share your thoughts..." required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-send"></i> Post Comment
                            </button>
                        </form>
                        <hr>
                    <% } else { %>
                        <div class="alert alert-info mb-4">
                            <i class="bi bi-info-circle"></i> Please <a href="/user/signin" class="alert-link">sign in</a> to leave a comment.
                        </div>
                    <% } %>

                    <!-- Comments List -->
                    <% if (blog.comments && blog.comments.length > 0) { %>
                        <div class="comments-list">
                            <% blog.comments.forEach(function(comment, index) { %>
                                <div class="comment-item p-3 mb-3 <%= index % 2 === 0 ? 'bg-light' : '' %> rounded">
                                    <div class="d-flex align-items-start">
                                        <div class="flex-shrink-0">
                                            <div class="avatar-circle bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" 
                                                style="width: 40px; height: 40px; font-weight: bold;">
                                                <%= comment.createdBy ? comment.createdBy.fullName.charAt(0).toUpperCase() : 'A' %>
                                            </div>
                                        </div>
                                        <div class="flex-grow-1 ms-3">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <h6 class="mb-0 fw-bold text-primary">
                                                    <%= comment.createdBy ? comment.createdBy.fullName : 'Anonymous' %>
                                                </h6>
                                                <small class="text-muted">
                                                    <i class="bi bi-clock"></i> <%= new Date(comment.createdAt).toLocaleString() %>
                                                </small>
                                            </div>
                                            <p class="mb-0 text-dark">
                                                <%= comment.content %>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="text-center py-5">
                            <i class="bi bi-chat-square-text" style="font-size: 3rem; color: #ccc;"></i>
                            <p class="text-muted mt-3">No comments yet. Be the first to share your thoughts!</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

                <%- include('./partials/script') %>
</body>

</html>